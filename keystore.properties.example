# Copy this file to keystore.properties (git-ignored) and fill it in. See docs/RELEASING.md.
# Never commit keystore.properties or the .jks file.
storeFile=C:/Users/you/keys/rawcull-release.jks
storePassword=change-me
keyAlias=rawcull
# A PKCS12 keystore (keytool's default) uses the store password for the key too.
keyPassword=change-me
